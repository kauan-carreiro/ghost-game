/**
 * Ponto de entrada do jogo Ghost Multiplayer.
 */
class Main {
    function void main() {
        var GhostGame game;
        var int seed;

        do Output.moveCursor(11, 16);
        do Output.printString("Aperte uma tecla para comecar");

        let seed = 0;
        while (Keyboard.keyPressed() = 0) {
            let seed = seed + 1;
        }

        // Aguarda soltar a tecla para nao interferir no inicio da partida
        while (~(Keyboard.keyPressed() = 0)) { }

        do Random.setSeed(seed);
        do Map.init();

        let game = GhostGame.new();
        do game.run();
        do game.dispose();

        do Screen.clearScreen();
        do Output.moveCursor(11, 24);
        do Output.printString("Jogo encerrado.");
        return;
    }
}
