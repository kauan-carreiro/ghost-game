/**
 * TESTE da Pessoa A: so o mapa + fantasma.
 * Quando integrar, este Main vira o GhostGame da dupla (ou chama GhostGame.run()).
 *
 * Teclas: setas ou WASD movem; '.' ou 'e' param; ESC sai.
 * (Letras: use minusculas / CapsLock desligado.)
 */
class Main {
    function void main() {
        var Ghost ghost;
        var int key, c, seed;

        do Output.printString("Aperte uma tecla para comecar");
        // a demora do jogador gera a semente aleatoria
        let seed = 0;
        while (Keyboard.keyPressed() = 0) {
            let seed = seed + 1;
        }
        do Random.setSeed(seed);
        do Screen.clearScreen();
        do Output.moveCursor(0, 0);

        do Map.init();
        do Map.draw();

        let c = Map.randomCell();
        let ghost = Ghost.new(Map.cellX(c), Map.cellY(c));

        let key = 0;
        while (~(key = 140)) {                 // 140 = ESC
            let key = Keyboard.keyPressed();
            if ((key = 131) | (key = 119)) { do ghost.setDirection(1); }  // seta cima  | w
            if ((key = 133) | (key = 115)) { do ghost.setDirection(2); }  // seta baixo | s
            if ((key = 130) | (key = 97))  { do ghost.setDirection(3); }  // seta esq   | a
            if ((key = 132) | (key = 100)) { do ghost.setDirection(4); }  // seta dir   | d
            if ((key = 46)  | (key = 101)) { do ghost.setDirection(0); }  // '.'        | e  (parar)
            do ghost.move();
            do Sys.wait(100);                  // 10 passos por segundo
        }

        do ghost.dispose();
        return;
    }
}
