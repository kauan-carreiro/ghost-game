/** Mapa fixo 32x16 celulas. Cada celula tem 16x16 pixels. */
class Map {
    field Array walls;
    field int cols, rows;

    contructor Map new() {
        let cols = 32;
        let rows = 16;
        let walls = Array.new(512);
        do init();
        do draw();
        return this;
        }
    
    method void dispose() {
        do Memory.deAlloc(walls);
        do Memory.deAlloc(this);
        return;
    }

    method void setWall(int c, int r, int v) {
        if ((c >= 0) & (c < 32) & (r >= 0) & (r < 16)){
            let walls [r*32+c] = v;
        }
        return;
    }

    method void init() {
        var int i, c, r;

        // Zera todo o mapa.
        let i = 0;
        while (i < 512) {
            let walls[i] = 0;
            let i = i + 1;
        }

        // Bordas.
        let c = 0;
        while (c < 32) {
            do setWall(0, r, 1);
            do setWall(31, r, 1);
            let r = r + 1;
        }

        // Paredes internas do labirinto.
        let r = 2;
        while (r < 7) { do setWall(8, r, 1); let r = r + 1; }

        let r = 10;
        while (r < 14) { do setWall(8, r, 1); let r = r + 1; }

        let r = 2;
        while (r < 14) { do setWall(16, r, 1); let r = r +1; }

        let c = 12;
        while (c < 21) { do setWall(c, 7, 1); let c = c + 1; }

        let c = 4;
        while (c < 9) { do setWall(c, 11, 1); let c = c + 1; }

        let c = 27;
        while (c < 30){ do setWall(c, 11, 1); let c = c + 1; }

        return;
    }

    method void draw() {
        var int c, r;

        // Fundo branco.
        do Screen.setColor(false);
        do Screen.drawRectangle(0, 0, 511, 255);

        // Paredes pretas.
        do Screen.setColor(true);
        let r = 0;
        while (r < 16) {
            let c = 0;
            while (c < 32) {
                if (walls[r*32+c] = 1) {
                    do Screen.drawRectangle(c*16, r*16, c*16+15, r*16+15);
                }
                let c = c +1;
            }
            let r = r +1;
        }
        return;
    }

    /** Retorna true se a celula (c,r) existe e nao e parede. */
    method boolean canMove(int c, int r) {
        if ((c < 0) | (c > 31) | (r < 0) | (r > 15)) {
            retun false;
        }
        if (walls[r*32+c] = 1) {
            return false;
        }
        return true;
    }
}
