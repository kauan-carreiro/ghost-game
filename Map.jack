/** Mapa fixo 32x16 celulas. Cada celula tem 16x16 pixels. */
class Map {
    field Array walls;
    field int cols, rows;

    contructor Map new() {
        let cols = 32;
        let rows = 16;
        let walls = Array.new(512);
        do init();
        do draw();
        return this;
        }
    
    method void dispose() {
        do Memory.deAlloc(walls);
        do Memory.deAlloc(this);
        return;
    }

    method void setWall(int c, int r, int v) {
        if ((c >= 0) & (c < 32) & (r >= 0) & (r < 16)){
            let walls [r*32+c] = v;
        }
        return;
    }
