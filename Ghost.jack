/**
 * Fantasma (J1). Anda de celula em celula na direcao escolhida
 * ate bater numa parede; direcao 0 = parado.
 *
 * Direcoes: 0 = parado, 1 = cima, 2 = baixo, 3 = esquerda, 4 = direita
 *
 * A classe Person (Pessoa B) deve ter a MESMA interface:
 *   new(x, y), setDirection(d), move(), draw(), getX(), getY(), dispose()
 */
class Ghost {
    field int x, y;   // posicao em celulas
    field int dir;

    constructor Ghost new(int startX, int startY) {
        let x = startX;
        let y = startY;
        let dir = 0;
        do draw();
        return this;
    }

    method void dispose() {
        do Memory.deAlloc(this);
        return;
    }

    method int getX() { return x; }
    method int getY() { return y; }
    method int getDirection() { return dir; }

    /** d: 0 parado, 1 cima, 2 baixo, 3 esquerda, 4 direita. */
    method void setDirection(int d) {
        let dir = d;
        return;
    }

    /** Avanca UMA celula na direcao atual. Se a proxima celula for parede, para. */
    method void move() {
        var int nx, ny;
        if (dir = 0) { return; }
        let nx = x;
        let ny = y;
        if (dir = 1) { let ny = y - 1; }
        if (dir = 2) { let ny = y + 1; }
        if (dir = 3) { let nx = x - 1; }
        if (dir = 4) { let nx = x + 1; }

        if (Map.canMove(nx, ny)) {
            do erase();
            let x = nx;
            let y = ny;
            do draw();
        } else {
            let dir = 0;   // bateu na parede: para
        }
        return;
    }

    /** Desenha: corpo preto com dois olhos brancos. */
    method void draw() {
        var int px, py;
        let px = Math.multiply(x, 16);
        let py = Math.multiply(y, 16);
        do Screen.setColor(true);
        do Screen.drawRectangle(px + 2, py + 2, px + 13, py + 13);
        do Screen.setColor(false);
        do Screen.drawRectangle(px + 4, py + 5, px + 6, py + 8);
        do Screen.drawRectangle(px + 9, py + 5, px + 11, py + 8);
        do Screen.setColor(true);
        return;
    }

    method void erase() {
        do Map.clearCell(x, y);
        return;
    }
}
