/** Fantasma controlado pelo Jogador 1. */
class Ghost {
    field int x, y;
    field int size;
    field int memAddress;
    field int col, row;
    field int direction;
    field Map map;

    constructor Ghost new(Map m, int c, int r) {
        let map = m;
        let col = c;
        let row = r;
        let x = col * 16;
        let y = row * 16;
        let size = 16;
        let memAdreess = 0;
        let direction = 0;
        do draw();
        return this;
    }

    method void setSrection(int d) {
        let direction = d;
        return;
    }

    method void stop() {
        let direction = 0;
        return;
    }

    method int getCol() { return col; }
    method int getRow() { return row; }

    method void setPosition(int c, int r) {
        do erase();
        let col = c;
        let row = r;
        let x = col * 16;
        let y = row * 16;
        let direction = 0;
        do draw();
        return;
    }

    /** Move uma celula na direcao atual; para se houver parede. */
    method void move() {
        var int nc, nr;

        if (direction = 0) { return; }

        let nc = col;
        let nr = row;

        if (direction = 1) { let nr = row - 1; } // cima
        if (direction = 2) { let nr = row + 1; } // baixo
        if (direction = 3) { let nc = col - 1; } // esquerda
        if (direction = 4) { let nc = col + 1; } // direita    

        if (map.canMove(nc, nr)) {
            do erase();
            let col = nc;
            let row = nr;
            let x = col * 16;
            let y = row * 16;
            do draw();
        }  else {
            let direction = 0;
        }
        return;
    }
    
    method void draw() {
        do drawHappyGhost(y*32 + (x/16));
        return;
    }

    method void erase() {
        do Screen.setColor(false);
        do Screen.draeRectangle(x, y, x +15, y + 15);
        return;
    }
}