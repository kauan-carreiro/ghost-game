/**
 * Pessoa (J2). Mesma interface e logica de movimento do Ghost.
 * Direcoes: 0 = parado, 1 = cima, 2 = baixo, 3 = esquerda, 4 = direita
 */
class Person {
    field int x, y;
    field int dir;

    constructor Person new(int startX, int startY) {
        let x = startX;
        let y = startY;
        let dir = 0;
        do draw();
        return this;
    }

    method void dispose() {
        do Memory.deAlloc(this);
        return;
    }

    method int getX() { return x; }
    method int getY() { return y; }
    method int getDirection() { return dir; }

    method void setDirection(int d) {
        let dir = d;
        return;
    }

    method void move() {
        var int nx, ny;
        if (dir = 0) { return; }
        let nx = x;
        let ny = y;
        if (dir = 1) { let ny = y - 1; }
        if (dir = 2) { let ny = y + 1; }
        if (dir = 3) { let nx = x - 1; }
        if (dir = 4) { let nx = x + 1; }

        if (Map.canMove(nx, ny)) {
            do erase();
            let x = nx;
            let y = ny;
            do draw();
        } else {
            let dir = 0;
        }
        return;
    }

    /** Desenha boneco palito: cabeca, tronco, bracos e pernas. */
    method void draw() {
        var int px, py;
        let px = Math.multiply(x, 16);
        let py = Math.multiply(y, 16);
        do Screen.setColor(true);
        // Cabeca
        do Screen.drawCircle(px + 8, py + 4, 2);
        // Tronco
        do Screen.drawLine(px + 8, py + 7, px + 8, py + 11);
        // Bracos
        do Screen.drawLine(px + 4, py + 8, px + 12, py + 8);
        // Pernas
        do Screen.drawLine(px + 8, py + 11, px + 5, py + 14);
        do Screen.drawLine(px + 8, py + 11, px + 11, py + 14);
        return;
    }

    method void erase() {
        do Map.clearCell(x, y);
        return;
    }
}
