/**
 * Regras do jogo:
 * - Fase 0: 3 segundos iniciais. A pessoa pode fugir; o fantasma nao move.
 * - Fase 1: 7 segundos de caca. Os dois se movem.
 * - Fase 2: Game Over. Reinicia automaticamente apos 3 segundos.
 * - ESC encerra o jogo.
 */
class GhostGame {
   field int phase;
   field int prepTime;
   field int chaseTime;
   field int tick;
   field int gameOverTicks;
   field int winner;
   field Random random;
   field Map map;
   field Ghost ghost;
   field Person person;

   constructor GhostGame new() {
      let map = Map.new();
      let random = Random.new(19);
      let ghost = Ghost.new(map, 1, 1);
      let person = Person.new(map, 2, 2);

      let phase = 0;
      let prepTime = 3;
      let chaseTime = 7;
      let tick = 0;
      let gameOverTicks = 0;
      let winner = 0;

      do reset();
      return this;
   }

   method void dispose() {
    do ghost.dispose();
    do person.dispose();
    do map.dispose();
    do random.dispose();
    do Memory.deAlloc(this);
    return;
   }
   
method void reset() {
   do map.draw();
   do placePlayers();

   let phase = 0;
   let prepTime = 3;
   let chaseTime = 7;
   let tick = 0;
   let gameOverTicks = 0;
   let winner = 0;

   do drawStatus();
   return;
}

/** Sorteia posicoes validas e diferentes para os dois jogadores. */
method void placePlayers() {
   var int gc, gr, pc, pr;
   var boolean ok;

   let ok = false;
   while (~ok) {
      let gc = random.randRange(31);
      let gr = random.randRange(15);
      if (map.canMove(gc, gr)) {
         let ok = true;
      }
   }

   let ok = false;
   while (~ok) {
      let pc = random.randRange(31);
      let pr = random.randRange(15);
      if (map.canMove(pc, pr)) {
         if (~((pc = gc) & (pr = gr))) {
            let ok = true;
         }
      }
   }

   do ghost.setPosition(gc, gr);
   do person.setPosition(pc, pr);
   return;
}

method void drawStatus() {
    do Output.moveCursor(0, 0);
    do Output.printString("Fuga: ");
    do Output.printInt(prepTime);
    do Output.printString(" ");

    do Output.moveCursor(0, 20);
    do Output.printString("Caca: ");
    do Output.printInt(chaseTime);
    do Output.printString(" ");
    return;
}

method void showameOver(int w) {
    do Output.moveCursor(10, 8);

    if (w = 1) {
        do Output.printString("Game Over - Jogador 2 perdeu");
    }
    if (w = 2) {
        do Output.printString("Game Over - Jogador 1 perdeu");
    }

    do Output.printScring("     ");
    return;
}

/** Durante os 3 segundos iniciais, apenas a pessoa se movimenta. */
method void handlePrepKeys(char key) {
   if (key = 119) { do person.setDirection(1); } // w
   if (key = 115) { do person.setDirection(2); } // s
   if (key = 97)  { do person.setDirection(3); } // a
   if (key = 100) { do person.setDirection(4); } // d
   if (key = 101) { do person.stop(); }          // e
   return;
}
}